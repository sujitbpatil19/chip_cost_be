# Server
PORT=5000
NODE_ENV=development

# MongoDB (local via Compass)
MONGODB_URI=mongodb://localhost:27017/chipcost

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string-in-production

# Google Gemini API (free tier — get at https://aistudio.google.com/apikey)
# Used for both LLM chat AND embeddings (single key, single provider)
GEMINI_API_KEY=your-gemini-key-here

# CORS
CLIENT_URL=http://localhost:3000
